@model BTL_LTW.Models.Student
@{
    ViewData["Title"] = "Xác Nhận Xóa Hồ Sơ Sinh Viên";
}

<div class="container-xxl flex-grow-1">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Đào tạo / Sinh viên /</span> Xác nhận xóa hồ sơ
    </h4>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card text-center p-4">
                <div class="avatar avatar-xl mx-auto mb-3" style="width: 70px; height: 70px;">
                    <span class="avatar-initial rounded-circle bg-label-danger p-3">
                        <i class="bx bx-error-circle fs-1"></i>
                    </span>
                </div>
                <h4 class="fw-bold text-danger mb-2">Bạn có chắc chắn muốn xóa sinh viên này?</h4>
                <p class="text-muted mb-4 small">Hành động này sẽ xóa vĩnh viễn hồ sơ và toàn bộ kết quả bảng điểm của sinh viên khỏi hệ thống.</p>

                <div class="card bg-light border-0 p-3 mb-4 text-start">
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-lg me-3" style="width: 50px; height: 50px;">
                            <img src="@Model.Avatar" class="rounded-circle border" alt="@Model.FullName">
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@Model.FullName</h5>
                            <span class="badge bg-label-dark">@Model.StudentCode</span>
                        </div>
                    </div>
                    <div class="small">
                        <div class="mb-1"><strong>Khoa:</strong> @Model.DepartmentName</div>
                        <div class="mb-1"><strong>Lớp:</strong> @Model.ClassName</div>
                        <div class="mb-1"><strong>Email:</strong> @Model.Email</div>
                        <div><strong>Điểm GPA:</strong> <span class="fw-bold text-danger">@Model.GPA</span></div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-label-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bx bx-trash me-1"></i> Xác nhận xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
