@model BTL_LTW.Models.Student
@{
    ViewData["Title"] = "Chi Tiết Hồ Sơ: " + Model.FullName;
    var grades = ViewBag.Grades as List<BTL_LTW.Models.Grade> ?? new List<BTL_LTW.Models.Grade>();
    var dept = ViewBag.Department as BTL_LTW.Models.Department;
}

<div class="container-xxl flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <span class="text-muted fw-light">Đào tạo / Sinh viên /</span> Hồ sơ: @Model.FullName
        </h4>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bx bx-edit-alt me-1"></i> Chỉnh sửa hồ sơ
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Danh sách
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột Trái: Thông tin Sinh Viên -->
        <div class="col-xl-4 col-lg-5">
            <div class="card mb-4 text-center p-3">
                <div class="card-body">
                    <div class="mx-auto mb-3" style="width: 100px; height: 100px;">
                        <img src="@Model.Avatar" class="rounded-circle border border-3 border-primary w-100 h-100 object-fit-cover shadow-sm" alt="@Model.FullName">
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                    <span class="badge bg-label-dark fs-6 mb-2">@Model.StudentCode</span>
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge @Model.StatusBadgeClass">@Model.StatusText</span>
                        <span class="badge @Model.RankBadgeClass">Học lực @Model.AcademicRank</span>
                    </div>

                    <div class="text-start bg-light rounded-3 p-3 small mb-3">
                        <div class="mb-2"><strong><i class="bx bx-buildings text-primary me-2"></i>Khoa:</strong> @Model.DepartmentName</div>
                        <div class="mb-2"><strong><i class="bx bxs-graduation text-primary me-2"></i>Lớp:</strong> @Model.ClassName</div>
                        <div class="mb-2"><strong><i class="bx bx-calendar text-primary me-2"></i>Khóa học:</strong> @Model.EnrollmentYear</div>
                        <div><strong><i class="bx bx-star text-warning me-2"></i>Điểm GPA tích lũy:</strong> <span class="fs-6 fw-bold text-danger">@Model.GPA / 10.0</span></div>
                    </div>

                    <div class="divider text-start mb-3">
                        <div class="divider-text text-muted small">LIÊN HỆ</div>
                    </div>

                    <ul class="list-unstyled text-start small mb-0">
                        <li class="mb-2 text-truncate"><i class="bx bx-envelope text-primary me-2"></i>@Model.Email</li>
                        <li class="mb-2"><i class="bx bx-phone text-primary me-2"></i>@Model.Phone</li>
                        <li class="mb-2"><i class="bx bx-cake text-primary me-2"></i>@Model.Birthday.ToString("dd/MM/yyyy") (@(Model.Gender == 1 ? "Nam" : "Nữ"))</li>
                        <li><i class="bx bx-map text-primary me-2"></i>@Model.Address</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Bảng điểm & Học phần -->
        <div class="col-xl-8 col-lg-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold"><i class="bx bx-book-open text-primary me-2"></i>Kết Quả Học Phần Đã Tích Lũy</h5>
                    <a asp-controller="Grade" asp-action="Create" asp-route-studentId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bx bx-plus me-1"></i> Nhập điểm môn mới
                    </a>
                </div>
                <div class="table-responsive text-nowrap">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Mã môn</th>
                                <th>Tên môn học</th>
                                <th class="text-center">Số TC</th>
                                <th class="text-center">CC (10%)</th>
                                <th class="text-center">GK (30%)</th>
                                <th class="text-center">CK (60%)</th>
                                <th class="text-center">Tổng kết</th>
                                <th class="text-center">Điểm chữ</th>
                                <th class="text-center">Kết quả</th>
                                <th class="text-end">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!grades.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="bx bx-error-circle fs-1 d-block mb-2"></i>
                                        Sinh viên này chưa có kết quả điểm học phần nào.
                                    </td>
                                </tr>
                            }
                            @foreach (var g in grades)
                            {
                                <tr>
                                    <td><span class="badge bg-label-dark">@g.CourseCode</span></td>
                                    <td class="fw-semibold text-dark">@g.CourseName</td>
                                    <td class="text-center">@g.Credits</td>
                                    <td class="text-center">@g.AttendanceScore</td>
                                    <td class="text-center">@g.MidtermScore</td>
                                    <td class="text-center">@g.FinalScore</td>
                                    <td class="text-center fw-bold text-primary">@g.AverageScore</td>
                                    <td class="text-center">
                                        <span class="badge @(g.LetterGrade.StartsWith("A") ? "bg-label-danger" : g.LetterGrade.StartsWith("B") ? "bg-label-success" : "bg-label-secondary")">
                                            @g.LetterGrade
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (g.IsPassed)
                                        {
                                            <span class="badge bg-label-success">Đạt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-label-danger">Học lại</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-controller="Grade" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa kết quả môn này?');">
                                            <input type="hidden" name="id" value="@g.Id" />
                                            <input type="hidden" name="studentId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-icon btn-label-danger" title="Xóa điểm">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (grades.Any())
                {
                    <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Tổng số tín chỉ: <strong>@grades.Sum(g => g.Credits)</strong></span>
                        <div>
                            <span class="text-muted small me-2">Điểm trung bình chung (GPA):</span>
                            <span class="badge bg-primary fs-6">@Model.GPA / 10.0</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
