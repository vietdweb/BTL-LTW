@model IEnumerable<BTL_LTW.Models.Department>
@{
    ViewData["Title"] = "Quản Lý Khoa & Viện Đào Tạo";
}

<div class="container-xxl flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <span class="text-muted fw-light">Đào tạo /</span> Khoa & Viện chuyên môn
        </h4>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Thêm khoa mới
        </a>
    </div>

    <div class="row g-4">
        @foreach (var d in Model)
        {
            <div class="col-md-6 col-xl-6">
                <div class="card h-100 hover-lift">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <div class="avatar flex-shrink-0 me-3">
                                    <span class="avatar-initial rounded bg-label-primary p-2">
                                        <i class="bx bx-buildings fs-3"></i>
                                    </span>
                                </div>
                                <div>
                                    <span class="badge bg-label-primary mb-1">@d.DepartmentCode</span>
                                    <h5 class="card-title fw-bold text-dark mb-0">@d.Name</h5>
                                </div>
                            </div>
                            <span class="badge @(d.Status == 1 ? "bg-label-success" : "bg-label-secondary")">
                                @(d.Status == 1 ? "Đang đào tạo" : "Tạm ngưng")
                            </span>
                        </div>

                        <p class="text-muted small mb-3 text-truncate-2" style="min-height: 42px;">@d.Description</p>

                        <div class="p-3 bg-light rounded-3 mb-3 small">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted"><i class="bx bx-user text-primary me-1"></i>Trưởng khoa:</span>
                                <strong class="text-dark">@d.Dean</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted"><i class="bx bx-phone text-primary me-1"></i>Điện thoại:</span>
                                <strong>@d.Phone</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bx bx-group text-primary me-1"></i>Quy mô hiện tại:</span>
                                <span class="badge bg-label-primary">@d.StudentCount sinh viên</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-label-info">
                                <i class="bx bx-show me-1"></i> Xem chi tiết & DSSV
                            </a>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-icon btn-label-primary" title="Sửa">
                                    <i class="bx bx-edit-alt"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-icon btn-label-danger" title="Xóa">
                                    <i class="bx bx-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
