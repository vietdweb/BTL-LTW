@model IEnumerable<BTL_LTW.Models.Grade>
@{
    ViewData["Title"] = "Quản Lý Bảng Điểm & Học Tập";
    var selectedStudent = ViewBag.SelectedStudent as BTL_LTW.Models.Student;
}

<div class="container-xxl flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <span class="text-muted fw-light">Đào tạo /</span> Quản lý bảng điểm & học phần
        </h4>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Nhập điểm môn học
        </a>
    </div>

    <!-- Lọc điểm theo sinh viên -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-7">
                    <select name="studentId" asp-items="@ViewBag.Students" class="form-select">
                        <option value="">-- Xem bảng điểm của tất cả sinh viên --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bx bx-filter-alt me-1"></i> Lọc điểm
                    </button>
                </div>
                <div class="col-md-2 text-end">
                    <a asp-action="Index" class="btn btn-label-secondary w-100">
                        <i class="bx bx-refresh me-1"></i> Tất cả
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (selectedStudent != null)
    {
        <div class="card mb-4 border border-primary border-opacity-25 bg-label-primary">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="avatar avatar-online me-3" style="width: 48px; height: 48px;">
                        <img src="@selectedStudent.Avatar" class="rounded-circle" alt="@selectedStudent.FullName" />
                    </div>
                    <div>
                        <h5 class="fw-bold text-primary mb-0">@selectedStudent.FullName (@selectedStudent.StudentCode)</h5>
                        <small class="text-muted">Khoa: @selectedStudent.DepartmentName &bull; Lớp: @selectedStudent.ClassName</small>
                    </div>
                </div>
                <div class="mt-2 mt-md-0">
                    <span class="fw-semibold me-2">Điểm GPA tích lũy:</span>
                    <span class="badge bg-danger fs-6">@selectedStudent.GPA / 10.0</span>
                    <span class="badge @selectedStudent.RankBadgeClass ms-1">@selectedStudent.AcademicRank</span>
                </div>
            </div>
        </div>
    }

    <!-- Bảng điểm chi tiết -->
    <div class="card">
        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold"><i class="bx bx-table text-primary me-2"></i>Danh Sách Kết Quả Học Phần (@Model.Count() bản ghi)</h5>
        </div>
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã SV</th>
                        <th>Họ và Tên SV</th>
                        <th>Mã môn</th>
                        <th>Tên môn học</th>
                        <th class="text-center">Số TC</th>
                        <th class="text-center">CC (10%)</th>
                        <th class="text-center">GK (30%)</th>
                        <th class="text-center">CK (60%)</th>
                        <th class="text-center">Tổng kết</th>
                        <th class="text-center">Điểm chữ</th>
                        <th class="text-center">Kết quả</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">
                                <i class="bx bx-folder-open fs-1 d-block mb-2"></i>
                                Chưa có bản ghi điểm học phần nào.
                            </td>
                        </tr>
                    }
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td><span class="badge bg-label-dark">@g.StudentCode</span></td>
                            <td class="fw-semibold text-dark">@g.StudentName</td>
                            <td><span class="badge bg-label-secondary">@g.CourseCode</span></td>
                            <td>@g.CourseName</td>
                            <td class="text-center">@g.Credits</td>
                            <td class="text-center">@g.AttendanceScore</td>
                            <td class="text-center">@g.MidtermScore</td>
                            <td class="text-center">@g.FinalScore</td>
                            <td class="text-center fw-bold text-primary">@g.AverageScore</td>
                            <td class="text-center">
                                <span class="badge @(g.LetterGrade.StartsWith("A") ? "bg-label-danger" : g.LetterGrade.StartsWith("B") ? "bg-label-success" : "bg-label-secondary")">
                                    @g.LetterGrade
                                </span>
                            </td>
                            <td class="text-center">
                                @if (g.IsPassed)
                                {
                                    <span class="badge bg-label-success">Đạt</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-danger">Học lại</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa điểm môn này?');">
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <input type="hidden" name="studentId" value="@g.StudentId" />
                                    <button type="submit" class="btn btn-icon btn-label-danger" title="Xóa">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
