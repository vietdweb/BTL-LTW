@model BTL_LTW.Models.Student
@{
    ViewData["Title"] = "Cổng Tra Cứu Điểm & Kết Quả Học Tập";
    var grades = ViewBag.Grades as List<BTL_LTW.Models.Grade> ?? new List<BTL_LTW.Models.Grade>();
}

<div class="container-xxl flex-grow-1">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Tra cứu /</span> Kết quả học tập trực tuyến
    </h4>

    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="card text-center p-4">
                <div class="card-body">
                    <div class="avatar avatar-lg mx-auto mb-3" style="width: 60px; height: 60px;">
                        <span class="avatar-initial rounded-circle bg-label-primary p-3">
                            <i class="bx bx-search fs-2"></i>
                        </span>
                    </div>
                    <h5 class="card-title fw-bold text-primary mb-2">Tra Cứu Bảng Điểm & Học Phần</h5>
                    <p class="text-muted small mb-4">Nhập mã số sinh viên để hệ thống truy xuất toàn bộ dữ liệu điểm thi và xếp loại học tập.</p>

                    <form method="get" asp-action="Lookup" class="d-flex gap-2 max-w-lg mx-auto">
                        <div class="input-group search-input-group flex-grow-1">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                                <i class="bx bx-barcode fs-5"></i>
                            </span>
                            <input type="text" name="studentCode" class="form-control border-0 bg-transparent shadow-none" placeholder="Nhập mã SV (VD: SV202201, SV202202...)" value="@Model?.StudentCode" required>
                        </div>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold text-nowrap">
                            <i class="bx bx-search me-1"></i> Tra cứu
                        </button>
                    </form>

                    <div class="mt-3">
                        <small class="text-muted">
                            Mã sinh viên mẫu để thử nghiệm: 
                            <a href="?studentCode=SV202201" class="badge bg-label-primary text-decoration-none">SV202201</a>
                            <a href="?studentCode=SV202202" class="badge bg-label-info text-decoration-none">SV202202</a>
                            <a href="?studentCode=SV202203" class="badge bg-label-success text-decoration-none">SV202203</a>
                            <a href="?studentCode=SV202204" class="badge bg-label-warning text-decoration-none">SV202204</a>
                        </small>
                    </div>
                </div>
            </div>

            @if (ViewBag.NotFoundMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mt-3" role="alert">
                    <i class="bx bx-error-circle fs-4 me-2"></i>
                    <div>@ViewBag.NotFoundMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Kết quả thông tin sinh viên -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-auto text-center mb-3 mb-md-0">
                        <div class="avatar avatar-xl" style="width: 80px; height: 80px;">
                            <img src="@Model.Avatar" class="rounded-circle border border-2 border-primary" alt="@Model.FullName" />
                        </div>
                    </div>
                    <div class="col-md">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                            <span class="badge bg-label-primary fs-6">@Model.StudentCode</span>
                        </div>
                        <div class="text-muted small">
                            <span class="me-3"><i class="bx bx-buildings text-primary me-1"></i>Khoa: <strong>@Model.DepartmentName</strong></span>
                            <span class="me-3"><i class="bx bxs-graduation text-primary me-1"></i>Lớp: <strong>@Model.ClassName</strong></span>
                            <span><i class="bx bx-user text-primary me-1"></i>Giới tính: <strong>@(Model.Gender == 1 ? "Nam" : "Nữ")</strong></span>
                        </div>
                    </div>
                    <div class="col-md-auto text-md-end mt-3 mt-md-0">
                        <div class="p-3 bg-light rounded-3 text-center d-inline-block">
                            <small class="text-muted fw-bold d-block">ĐIỂM GPA TÍCH LŨY</small>
                            <h2 class="text-danger fw-bold mb-0">@Model.GPA <span class="fs-6 text-muted">/ 10</span></h2>
                            <span class="badge @Model.RankBadgeClass mt-1">@Model.AcademicRank</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng điểm chi tiết môn học -->
        <div class="card">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bx bx-book-bookmark text-primary me-2"></i>Bảng Điểm Học Phần Đã Hoàn Thành</h5>
                <span class="badge bg-label-primary">@grades.Count môn học</span>
            </div>
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã môn</th>
                            <th>Tên môn học</th>
                            <th class="text-center">Số TC</th>
                            <th class="text-center">Chuyên cần (10%)</th>
                            <th class="text-center">Giữa kỳ (30%)</th>
                            <th class="text-center">Cuối kỳ (60%)</th>
                            <th class="text-center">Tổng kết</th>
                            <th class="text-center">Điểm chữ</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!grades.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">Chưa có kết quả điểm học phần nào được cập nhật.</td>
                            </tr>
                        }
                        @foreach (var g in grades)
                        {
                            <tr>
                                <td><span class="badge bg-label-dark">@g.CourseCode</span></td>
                                <td class="fw-semibold text-dark">@g.CourseName</td>
                                <td class="text-center">@g.Credits</td>
                                <td class="text-center">@g.AttendanceScore</td>
                                <td class="text-center">@g.MidtermScore</td>
                                <td class="text-center">@g.FinalScore</td>
                                <td class="text-center fw-bold text-primary">@g.AverageScore</td>
                                <td class="text-center">
                                    <span class="badge @(g.LetterGrade.StartsWith("A") ? "bg-label-danger" : g.LetterGrade.StartsWith("B") ? "bg-label-success" : "bg-label-secondary")">
                                        @g.LetterGrade
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (g.IsPassed)
                                    {
                                        <span class="badge bg-label-success">Đạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-danger">Chưa đạt</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (grades.Any())
            {
                <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Tổng số tín chỉ tích lũy: <strong>@grades.Sum(g => g.Credits)</strong></span>
                    <div>
                        <span class="text-muted small me-2">GPA:</span>
                        <span class="badge bg-primary fs-6">@Model.GPA / 10.0</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
