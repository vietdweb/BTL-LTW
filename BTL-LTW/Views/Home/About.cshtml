@{
    ViewData["Title"] = "Giới Thiệu Về Hệ Thống Đào Tạo";
}

<div class="container-xxl flex-grow-1">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Hệ thống /</span> Giới thiệu về EduPortal
    </h4>

    <div class="card mb-4 greeting-card p-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-label-primary px-3 py-1 mb-2 fw-bold">SỨ MỆNH ĐÀO TẠO</span>
                <h3 class="fw-bold text-primary mb-2">Chuyển Đổi Số Giáo Dục & Chuẩn Hóa Học Vụ</h3>
                <p class="text-muted mb-0">
                    Hệ thống Quản lý Sinh viên EduPortal được xây dựng nhằm tin học hóa và tự động hóa toàn diện quy trình tiếp nhận hồ sơ, phân lớp theo khoa viện, tính điểm tín chỉ và tra cứu kết quả học tập trực tuyến 24/7.
                </p>
            </div>
            <div class="col-lg-4 text-center mt-3 mt-lg-0">
                <i class="bx bxs-institution text-primary" style="font-size: 5rem;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0 fw-bold"><i class="bx bx-check-shield text-success me-2"></i>Mục Tiêu & Tính Năng Trọng Tâm</h5>
                </div>
                <div class="card-body pt-3">
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex align-items-start mb-3">
                            <i class="bx bx-check-circle text-success fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Quản lý hồ sơ toàn diện</h6>
                                <p class="text-muted small mb-0">Lưu trữ thông tin cá nhân, ngày sinh, quê quán, số điện thoại, ảnh đại diện và trạng thái học vụ.</p>
                            </div>
                        </li>
                        <li class="d-flex align-items-start mb-3">
                            <i class="bx bx-check-circle text-success fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Tính điểm trung bình GPA tự động</h6>
                                <p class="text-muted small mb-0">Hệ thống tự động tính điểm tổng kết môn học (10% CC + 30% GK + 60% CK), quy đổi thang điểm chữ A/B/C/D/F và tính GPA tích lũy chuẩn quy chế Bộ GD&ĐT.</p>
                            </div>
                        </li>
                        <li class="d-flex align-items-start mb-3">
                            <i class="bx bx-check-circle text-success fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Tra cứu trực tuyến tức thì</h6>
                                <p class="text-muted small mb-0">Sinh viên và phụ huynh dễ dàng tra cứu bảng điểm các học phần chỉ bằng mã sinh viên.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0 fw-bold"><i class="bx bx-code-alt text-primary me-2"></i>Kiến Trúc & Công Nghệ Dự Án</h5>
                </div>
                <div class="card-body pt-3">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted"><i class="bx bx-layer me-2 text-primary"></i>Kiến trúc mô hình:</span>
                        <strong class="text-dark">ASP.NET Core MVC (.NET 10)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted"><i class="bx bx-slider me-2 text-primary"></i>Phân quyền giao diện:</span>
                        <span class="badge bg-label-primary">ASP.NET Core Areas (Area Admin)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted"><i class="bx bx-palette me-2 text-primary"></i>Thiết kế giao diện:</span>
                        <strong class="text-dark">Sneat Bootstrap 5 Admin Template</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted"><i class="bx bx-font me-2 text-primary"></i>Typography & Icons:</span>
                        <strong class="text-dark">Public Sans & Boxicons</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted"><i class="bx bx-check-double me-2 text-primary"></i>Kiểm soát dữ liệu:</span>
                        <span class="badge bg-label-success">Data Annotations Tiếng Việt</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
